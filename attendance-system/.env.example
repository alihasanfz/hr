NODE_ENV=development
PORT=3000

# Neon: copy the connection string from the Neon dashboard (it already contains sslmode=require)
DATABASE_URL=postgres://attendance:attendance@localhost:5432/attendance

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

TIMEZONE=Asia/Dhaka
AUTO_MIGRATE=true

# Shown on the login page until changed under Settings
COMPANY_NAME=Your Company Name

# First Admin, created automatically on start only while the users table is empty.
# Use a strong password (10+ characters). Remove ADMIN_PASSWORD from the environment after the first login.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Web push for Admin/HR alerts: run `npm run vapid` and paste the keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourcompany.com
