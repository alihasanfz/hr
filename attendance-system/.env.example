NODE_ENV=development
PORT=3000

# Neon: copy the connection string from the Neon dashboard (it already contains sslmode=require)
DATABASE_URL=postgres://attendance:attendance@localhost:5432/attendance

# Use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

TIMEZONE=Asia/Dhaka
AUTO_MIGRATE=true

# Creates demo users, employees and 30 days of history when the database is empty
SEED_DEMO=true
DEMO_PASSWORD=Demo@12345

# Web push for Admin/HR alerts: run `npm run vapid` and paste the keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
