<%- include('partials/head') %>
<header class="page-head"><h1>Holidays</h1></header>
<form method="post" action="/holidays" class="filters">
  <label>Date<input type="date" name="holiday_date" required></label>
  <label>Name<input name="name" required></label>
  <button class="btn">Add holiday</button>
</form>
<div class="scroll"><table class="tbl">
  <thead><tr><th>Date</th><th>Holiday</th><th></th></tr></thead>
  <tbody>
  <% rows.forEach((r) => { %><tr><td class="mono"><%= r.date %></td><td><%= r.name %></td>
    <td class="num"><form method="post" action="/holidays/<%= r.id %>/delete" class="inline" data-confirm="Remove this holiday?"><button class="link">Remove</button></form></td></tr><% }) %>
  <% if (!rows.length) { %><tr><td colspan="3" class="muted">No holidays yet. Days listed here count as off days for everyone.</td></tr><% } %>
  </tbody>
</table></div>
<%- include('partials/foot') %>
