<%- include('partials/head') %>
<header class="page-head"><h1>Settings</h1></header>
<form method="post" action="/settings" class="form">
  <div class="grid">
    <label>Company name<input name="company_name" value="<%= s.company_name %>" required></label>
    <label>Ignore repeat punches within (minutes)<input type="number" min="0" name="duplicate_gap_minutes" value="<%= s.duplicate_gap_minutes %>"><small class="muted">Stops a double tap on the device from counting as check-in and check-out.</small></label>
  </div>
  <div class="actions"><button class="btn">Save settings</button></div>
</form>
<%- include('partials/foot') %>
